{
  "architectureContractV": 1,
  "name": "Weavatrix Refactor transactional write boundary",
  "style": "ports-and-adapters",
  "enforcement": "strict",
  "components": [
    {
      "id": "model",
      "name": "Edit-plan model and pure transformations",
      "paths": ["src/edit-plan.mjs", "src/edit-engine.mjs"]
    },
    {
      "id": "platform",
      "name": "Filesystem, lock, token, and rollback storage adapters",
      "paths": ["src/fs-io.mjs", "src/refactor-home.mjs"]
    },
    {
      "id": "planners",
      "name": "Evidence-backed refactor plan engines",
      "paths": ["src/engines"]
    },
    {
      "id": "application",
      "name": "Preview, confirmation, apply, and rollback workflows",
      "paths": [
        "src/apply-session.mjs",
        "src/rollback.mjs",
        "src/tools.mjs",
        "src/plan-tools.mjs"
      ]
    },
    {
      "id": "adapter",
      "name": "Weavatrix extension and stdio MCP adapter",
      "paths": ["src/extension.mjs", "bin"]
    },
    {
      "id": "verification",
      "name": "Release verification",
      "paths": ["src/release-gate.mjs"]
    },
    {
      "id": "tests",
      "name": "Behavior and hardening tests",
      "paths": ["test"]
    }
  ],
  "dependencyRules": [
    {
      "id": "model-is-inward",
      "action": "forbid",
      "from": ["model"],
      "to": ["platform", "planners", "application", "adapter"],
      "kinds": ["imports", "re_exports", "depends_on"]
    },
    {
      "id": "platform-does-not-plan-or-orchestrate",
      "action": "forbid",
      "from": ["platform"],
      "to": ["planners", "application", "adapter"],
      "kinds": ["imports", "re_exports", "depends_on"]
    },
    {
      "id": "planners-do-not-own-write-workflows",
      "action": "forbid",
      "from": ["planners"],
      "to": ["application", "adapter"],
      "kinds": ["imports", "re_exports", "depends_on"]
    },
    {
      "id": "application-does-not-own-transport",
      "action": "forbid",
      "from": ["application"],
      "to": ["adapter"],
      "kinds": ["imports", "re_exports", "depends_on"]
    }
  ],
  "budgets": {
    "runtimeCycles": 0,
    "maxFileLoc": 300,
    "maxFunctionLoc": 100
  },
  "exceptions": []
}
