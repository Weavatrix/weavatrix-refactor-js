{
  "name": "weavatrix-refactor-js",
  "version": "0.1.6",
  "type": "module",
  "description": "Transactional refactoring MCP with 11 evidence-backed tools, hash-bound previews, and rollback.",
  "author": "Sergii Ziborov <sergii.ziborov@gmail.com>",
  "license": "MIT",
  "homepage": "https://weavatrix.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Weavatrix/weavatrix-refactor-js.git"
  },
  "bugs": {
    "url": "https://github.com/Weavatrix/weavatrix-refactor-js/issues"
  },
  "mcpName": "io.github.sergii-ziborov/weavatrix-refactor-js",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "weavatrix-refactor-js-mcp": "bin/weavatrix-refactor-js-mcp.mjs"
  },
  "exports": {
    "./extension": "./src/extension.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    ".weavatrix",
    "bin",
    "src",
    "skill",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "server.json"
  ],
  "scripts": {
    "test": "node --test",
    "verify:release": "node src/release-gate.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "refactoring",
    "rename-symbol",
    "safe-refactoring",
    "transactional-refactoring",
    "atomic-write",
    "rollback",
    "code-edit",
    "weavatrix",
    "claude",
    "coding-agents",
    "ai-agents"
  ],
  "dependencies": {
    "typescript": "5.9.3",
    "weavatrix-js": "^0.3.15"
  }
}
